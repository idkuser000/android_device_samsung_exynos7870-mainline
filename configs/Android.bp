prebuilt_etc {
    name: "init.recovery.exynos7870.rc",
    src: "init.recovery.exynos7870.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "ueventd.exynos7870.rc",
    src: "ueventd.exynos7870.rc",
    vendor: true,
}
